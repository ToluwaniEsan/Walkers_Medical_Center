---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import UrgentBanner from '../components/UrgentBanner.astro';
import { url } from '../lib/url';
import { site } from '../data/site';

const maps = site.locations.map((loc) => ({
  name: loc.name,
  src: `https://www.google.com/maps?q=${encodeURIComponent(loc.address)}&output=embed`,
  title: `Map of Walkers Medical Center, ${loc.name}`,
}));
---

<Base title="Contact & Appointments">
  <UrgentBanner title="Emergency? Call our 24-hour line now" text={site.hours.notes[0]} />

  <PageHero eyebrow="Contact" title="Contact & Appointments" />

  <section class="section" style="padding-top:0">
    <div class="container grid grid-3">
      <div class="card contact-card" data-reveal>
        <span class="card-icon"><Icon name="phone" /></span>
        <h2 class="h3">Phone</h2>
        <p class="contact-value">{site.phone.display}</p>
        <p class="muted">{site.phone.label}</p>
        <a href={site.phone.href} class="btn btn-primary"><Icon name="phone" size={18} /> Tap to call</a>
      </div>
      <div class="card contact-card" data-reveal>
        <span class="card-icon"><Icon name="mail" /></span>
        <h2 class="h3">Email</h2>
        <p class="contact-value">{site.email}</p>
        <a href={`mailto:${site.email}`} class="btn btn-ghost"><Icon name="mail" size={18} /> Tap to email</a>
      </div>
      <div class="card contact-card" data-reveal>
        <span class="card-icon"><Icon name="clock" /></span>
        <h2 class="h3">Hours</h2>
        <p class="contact-value">{site.hours.summary}</p>
        {site.hours.notes.map((n) => <p class="muted">{n}</p>)}
      </div>
    </div>
  </section>

  <section class="section section-mist">
    <div class="container">
      <div class="section-head"><h2>Find us</h2></div>
      <div class="grid grid-2">
        {
          site.locations.map((loc) => (
            <div class="card" data-reveal>
              <span class="card-icon"><Icon name="pin" /></span>
              <h3>{loc.name}</h3>
              <address class="muted">{loc.address}</address>
              <p style="margin-top:16px"><a href={loc.directions} class="btn btn-ghost" rel="noopener"><Icon name="pin" size={18} /> Get directions</a></p>
            </div>
          ))
        }
      </div>
      <div class="map-block" style="margin-top:24px">
        <div class="map-tabs" role="tablist" aria-label="Choose a location">
          {
            maps.map((m, i) => (
              <button type="button" role="tab" class="map-tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls="map-frame" data-map-src={m.src} data-map-title={m.title}>
                <Icon name="pin" size={16} /> {m.name}
              </button>
            ))
          }
        </div>
        <div class="map-frame" id="map-frame" role="tabpanel">
          <iframe src={maps[0].src} title={maps[0].title} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-band" data-reveal>
        <span class="card-icon"><Icon name="calendar" /></span>
        <h2>Call to book an appointment</h2>
        <p>For now, appointments are booked by phone.</p>
        <div class="btn-row">
          <a href={site.phone.href} class="btn btn-primary"><Icon name="phone" size={18} /> {site.phone.display}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-mist" id="message">
    <div class="container contact-form-wrap">
      <div class="section-head section-head-center">
        <h2>Send us a message</h2>
        <p class="lead">For questions, appointment requests or feedback. We reply by phone or email.</p>
      </div>
      <form class="card contact-form" action={site.form.action} method="POST" data-contact-form data-ajax={site.form.ajax} data-phone={site.phone.display} data-phone-href={site.phone.href} data-email={site.email} novalidate>
        <p class="form-note form-note-urgent">
          <Icon name="alert" size={18} />
          <span>Not for emergencies. If you need urgent care, call <a href={site.phone.href}>{site.phone.display}</a>.</span>
        </p>
        <div class="form-grid">
          <div class="field">
            <label for="f-name">Full name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="f-phone">Phone number</label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>
          <div class="field">
            <label for="f-email">Email <span class="optional">(optional)</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" />
          </div>
          <div class="field">
            <label for="f-branch">Branch</label>
            <select id="f-branch" name="branch">
              {site.locations.map((loc) => <option>{loc.name}</option>)}
              <option>Not sure</option>
            </select>
          </div>
          <div class="field field-wide field-topic">
            <label for="f-topic">What is it about?</label>
            <select id="f-topic" name="topic">
              <option>General question</option>
              <option>Appointment request</option>
              <option>Laboratory test</option>
              <option>Feedback</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field field-wide">
            <label for="f-message">Message</label>
            <textarea id="f-message" name="message" rows="5" required></textarea>
            <p class="field-hint">Please don't include detailed medical information. Our team will discuss that with you directly.</p>
          </div>
        </div>
        <label class="consent">
          <input type="checkbox" name="consent" value="Yes" required />
          <span>I agree that {site.shortName} can use these details to reply to me, as described in the <a href={url('/privacy/')}>privacy policy</a>.</span>
        </label>
        <!-- Spam trap: hidden from people, filled in by bots. -->
        <input type="text" name="_honey" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="New website message" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><Icon name="mail" size={18} /> Send message</button>
          <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  // Location tabs swap the map between the Ile-Ife and Ede branches.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.map-tab');
  const iframe = document.querySelector<HTMLIFrameElement>('#map-frame iframe');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      if (iframe && iframe.src !== tab.dataset.mapSrc) {
        iframe.src = tab.dataset.mapSrc!;
        iframe.title = tab.dataset.mapTitle!;
      }
    }),
  );

  // Contact form: send in the background and show the result in place.
  // Without JavaScript the form still posts straight to FormSubmit.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.classList.add('was-validated');
      form.querySelector<HTMLElement>(':invalid')?.focus();
      if (status) status.textContent = 'Please fill in the highlighted fields.';
      return;
    }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const data = Object.fromEntries(new FormData(form));
    if (data._honey) return;
    const topic = String(data.topic);
    data._subject = `Website message: ${topic} (${data.branch})`;
    if (data.email) data._replyto = data.email;
    button.disabled = true;
    if (status) status.textContent = 'Sending…';
    try {
      const res = await fetch(form.dataset.ajax || '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok || String(body.success) === 'false') throw new Error(body.message || res.statusText);
      form.reset();
      form.classList.remove('was-validated');
      form.classList.add('is-sent');
      if (status) status.textContent = 'Thank you. Your message has been sent and our team will get back to you.';
    } catch {
      if (status)
        status.innerHTML = `Sorry, your message could not be sent. Please call <a href="${form.dataset.phoneHref}">${form.dataset.phone}</a> or email <a href="mailto:${form.dataset.email}">${form.dataset.email}</a>.`;
    } finally {
      button.disabled = false;
    }
  });
</script>

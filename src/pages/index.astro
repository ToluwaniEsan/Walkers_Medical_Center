---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Todo from '../components/Todo.astro';
import UrgentBanner from '../components/UrgentBanner.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { site, services, whyChoose, facilities, promise, labMenu } from '../data/site';
---

<Base title={site.shortName}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card glass" data-reveal>
        <p class="eyebrow">Ile-Ife &amp; Ede, Osun State</p>
        <h1>{site.shortName}<span class="hero-sub">&amp; Orthopaedic Specialist Hospital</span></h1>
        <p class="hero-motto">“{site.motto}”</p>
        <p class="muted">{site.hours.summary}. {site.hours.notes[0]}</p>
        <div class="btn-row">
          <a href={site.phone.href} class="btn btn-primary"><Icon name="phone" size={18} /> Call now</a>
          <a href={url('/contact/')} class="btn btn-ghost"><Icon name="calendar" size={18} /> Book an appointment</a>
          <a href={site.locations[0].directions} class="btn btn-ghost" rel="noopener"><Icon name="pin" size={18} /> Get directions</a>
        </div>
      </div>
      <Photo slot="home-hero" label="Hospital exterior or care team" ratio="16 / 9" mobileRatio="3 / 2" class="hero-photo" eager />
    </div>
  </section>

  <UrgentBanner />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Our services</h2>
      </div>
      <div class="grid grid-tiles">
        {
          services.map((s) => (
            <a href={url('/services/')} class="card card-hover" data-reveal style="text-decoration:none;color:inherit">
              <span class="card-icon"><Icon name={s.icon} /></span>
              <h3>{s.title}</h3>
              <Todo text="short description" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <h2>Why choose Walkers</h2>
      </div>
      <div class="grid grid-4 grid-features">
        {
          whyChoose.map((w) => (
            <div class="card feature" data-reveal>
              <span class="card-icon"><Icon name={w.icon} /></span>
              <h3>{w.title}</h3>
              {w.text && <p>{w.text}</p>}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <Photo slot="about-gallery-1" label="Diagnostic equipment or ward" ratio="4 / 3" />
      <div data-reveal>
        <h2>Facilities &amp; care</h2>
        <p class="lead">{facilities}</p>
        <a href={url('/about/')} class="btn btn-ghost">About us <Icon name="arrow" size={18} class="btn-arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <h2>Laboratory &amp; diagnostics</h2>
      </div>
      <ul class="lab-summary" data-reveal>
        {
          labMenu.map((group) => (
            <li class="chip"><Icon name="microscope" size={16} /> {group.category} <span>· {group.tests.length} tests</span></li>
          ))
        }
      </ul>
      <a href={url('/laboratory/')} class="btn btn-primary">See all tests <Icon name="arrow" size={18} class="btn-arrow" /></a>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div data-reveal>
        <h2>Community outreach</h2>
        <Todo block text="Short summary of WMC community outreach programmes." />
        <p style="margin-top:20px"><a href={url('/outreach/')} class="btn btn-ghost">Our outreach <Icon name="arrow" size={18} class="btn-arrow" /></a></p>
      </div>
      <Photo slot="home-outreach" label="Community outreach event" ratio="4 / 3" />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="promise glass" data-reveal>
        <p class="eyebrow">Our promise</p>
        <h2 class="promise-quote">“{site.motto}”</h2>
        <p>{promise}</p>
      </div>
    </div>
  </section>

  <ContactStrip />
</Base>

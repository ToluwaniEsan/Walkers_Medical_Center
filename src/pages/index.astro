---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Todo from '../components/Todo.astro';
import UrgentBanner from '../components/UrgentBanner.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { site, services, whyChoose, facilities, promise, labMenu } from '../data/site';
---

<Base title={site.shortName}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-card glass" data-reveal>
        <p class="eyebrow">Ile-Ife &amp; Ede, Osun State</p>
        <h1>{site.name}</h1>
        <p class="hero-motto">“{site.motto}”</p>
        <p class="muted">{site.hours.summary}. {site.hours.notes[0]}</p>
        <div class="btn-row">
          <a href={site.phone.href} class="btn btn-primary"><Icon name="phone" size={18} /> Call now</a>
          <a href="/contact/" class="btn btn-ghost"><Icon name="calendar" size={18} /> Book an appointment</a>
          <a href={site.locations[0].directions} class="btn btn-ghost" rel="noopener"><Icon name="pin" size={18} /> Get directions</a>
        </div>
      </div>
      <Photo slot="home-hero" label="Hospital exterior or care team" ratio="16 / 9" mobileRatio="4 / 5" eager />
    </div>
  </section>

  <UrgentBanner />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Our services</h2>
      </div>
      <div class="grid grid-3">
        {
          services.map((s) => (
            <a href="/services/" class="card card-hover" data-reveal style="text-decoration:none;color:inherit">
              <span class="card-icon"><Icon name={s.icon} /></span>
              <h3>{s.title}</h3>
              <Todo text="short description" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <h2>Why choose Walkers</h2>
      </div>
      <div class="grid grid-4">
        {
          whyChoose.map((w) => (
            <div class="card feature" data-reveal>
              <span class="card-icon"><Icon name={w.icon} /></span>
              <h3>{w.title}</h3>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <Photo slot="about-gallery-1" label="Diagnostic equipment or ward" ratio="4 / 3" />
      <div data-reveal>
        <h2>Facilities &amp; care</h2>
        <p class="lead">{facilities}</p>
        <a href="/about/" class="btn btn-ghost">About us <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section section-mist">
    <div class="container">
      <div class="section-head">
        <h2>Laboratory &amp; diagnostics</h2>
      </div>
      <div class="grid grid-3">
        {
          labMenu.map((group) => (
            <div class="card" data-reveal>
              <span class="card-icon"><Icon name="microscope" /></span>
              <h3>{group.category}</h3>
              <ul class="lab-teaser muted">
                {group.tests.slice(0, 3).map((t) => <li>{t}</li>)}
              </ul>
              {group.tests.length > 3 && <p class="muted">+ {group.tests.length - 3} more</p>}
            </div>
          ))
        }
      </div>
      <p style="margin-top:28px"><a href="/laboratory/" class="btn btn-primary">See the full test menu <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div data-reveal>
        <h2>Community outreach</h2>
        <Todo block text="Short summary of WMC community outreach programmes." />
        <p style="margin-top:20px"><a href="/outreach/" class="btn btn-ghost">Our outreach <Icon name="arrow" size={18} /></a></p>
      </div>
      <Photo slot="home-outreach" label="Community outreach event" ratio="4 / 3" />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="promise" data-reveal>
        <p class="eyebrow">Our promise</p>
        <h2>“{site.motto}”</h2>
        <p>{promise}</p>
      </div>
    </div>
  </section>

  <ContactStrip />
</Base>

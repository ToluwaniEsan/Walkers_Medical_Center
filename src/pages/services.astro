---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Todo from '../components/Todo.astro';
import PageHero from '../components/PageHero.astro';
import FlipCard from '../components/FlipCard.astro';
import { site, services } from '../data/site';

const featured = services.find((s) => 'featured' in s && s.featured)!;
const others = services.filter((s) => s !== featured);
---

<Base title="Services">
  <PageHero eyebrow="Services" title="Our services">
    <Todo block text="One-line introduction to WMC services." />
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container">
      <article class="card featured-service" data-reveal>
        <Photo slot="services-featured" label="Orthopaedic consultation or theatre" ratio="4 / 3" eager />
        <div class="featured-body">
          <p class="chip"><Icon name="bone" size={16} /> Our specialty</p>
          <h2 style="margin-top:16px">{featured.title}</h2>
          <p class="lead">{featured.description}</p>
          <p style="margin-top:20px"><a href={site.phone.href} class="btn btn-primary"><Icon name="phone" size={18} /> Call to book</a></p>
        </div>
      </article>
    </div>
  </section>

  <section class="section section-mist">
    <div class="container">
      <div class="section-head"><h2>More services</h2></div>
      <div class="grid flip-grid">
        {
          others.map((s) => (
            <FlipCard title={s.title} icon={s.icon}>
              <p>{s.description}</p>
              {s.icon === 'flask' && <p><a href={url('/laboratory/')}>See the test menu</a></p>}
            </FlipCard>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card cta-band" data-reveal>
        <span class="card-icon"><Icon name="phone" /></span>
        <p>Speak with our team to learn which service is right for you.</p>
        <div class="btn-row">
          <a href={site.phone.href} class="btn btn-primary"><Icon name="phone" size={18} /> {site.phone.display}</a>
          <a href={url('/contact/')} class="btn btn-ghost">Contact &amp; appointments</a>
        </div>
      </div>
    </div>
  </section>
</Base>

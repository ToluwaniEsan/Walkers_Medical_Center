---
import { Image } from 'astro:assets';
import logo from '../assets/brand/wmc-logo.png';
import { site } from '../data/site';
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo', { 'logo-inverse': inverse }]}>
  <Image src={logo} alt="" width={56} height={56} densities={[1, 2]} class="logo-mark" loading="eager" />
  <span class="logo-text">
    <span class="logo-name">{site.shortName}</span>
    <span class="logo-sub">&amp; Orthopaedic Specialist Hospital</span>
  </span>
</span>

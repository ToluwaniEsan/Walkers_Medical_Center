---
import { url } from '../lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {
      eyebrow && (
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href={url('/')}>Home</a></li>
            <li><span aria-current="page">{eyebrow}</span></li>
          </ol>
        </nav>
      )
    }
    <h1>{title}</h1>
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</section>

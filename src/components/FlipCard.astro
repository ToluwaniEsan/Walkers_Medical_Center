---
// A card that lights up on hover and flips over on click or tap to show its
// description on the back. Both faces share one grid cell, so the card is as
// tall as its taller face and nothing jumps when it turns.
import Icon from './Icon.astro';

interface Props {
  title: string;
  icon?: string;
  /** Short line under the title on the front, e.g. "8 tests". */
  meta?: string;
  class?: string;
}
const { title, icon, meta, class: className } = Astro.props;
---

<div class:list={['flip', className]} data-flip data-reveal>
  <div class="flip-inner">
    <div class="flip-face flip-front">
      {icon && <span class="card-icon"><Icon name={icon} /></span>}
      <h3>{title}</h3>
      {meta && <p class="flip-meta">{meta}</p>}
      <button type="button" class="flip-btn" aria-expanded="false">
        <span class="visually-hidden">More about {title}</span>
        <span class="flip-hint" aria-hidden="true">Learn more <Icon name="flip" size={14} /></span>
      </button>
    </div>
    <div class="flip-face flip-back">
      <p class="flip-back-title">{title}</p>
      <div class="flip-body"><slot /></div>
      <button type="button" class="flip-btn flip-btn-back">
        <span class="visually-hidden">Back to {title}</span>
        <span class="flip-hint" aria-hidden="true"><Icon name="flip" size={14} /> Back</span>
      </button>
    </div>
  </div>
</div>
